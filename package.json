{
  "name": "hedgeway",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "India-first personal investing workspace, research pipeline and quantitative lab",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --use-env-proxy --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --import tsx server/index.ts",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "ingest": "node --use-env-proxy --import tsx server/ingest-cli.ts",
    "setup": "node scripts/setup.mjs",
    "backup": "node --import tsx scripts/backup.ts",
    "smoke": "node tests/container-smoke.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "fast-xml-parser": "^5.0.0",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.468.0",
    "protobufjs": "^8.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tsx": "^4.20.0",
    "ws": "^8.22.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
