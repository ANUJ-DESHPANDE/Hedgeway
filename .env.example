# Node 24+. Default is loopback-only, single-user local mode.
HOST=127.0.0.1
PORT=4100
DATABASE_PATH=./data/hedgeway.sqlite
# Required when binding a non-loopback host. Use 20+ random characters.
APP_PASSWORD=
# Exact external origin when deployed behind HTTPS; also used for CSRF checks.
APP_ORIGIN=http://localhost:4100
COOKIE_SECURE=false
# 32 random bytes in base64; required for encrypted Kite sessions.
TOKEN_ENCRYPTION_KEY=
KITE_API_KEY=
KITE_API_SECRET=
# Register APP_ORIGIN/api/kite/callback in the Kite developer console.
# Official Reddit OAuth access requires an approved API application.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hedgeway-personal-research/2.0
# Live-data provider: upstox (free Analytics Token) or kite (paid data entitlement).
MARKET_PROVIDER=upstox
# Prefer entering the token in the authenticated Integrations page.
UPSTOX_ACCESS_TOKEN=
# Worker polls approved RSS feeds and IPO provider every 5 minutes when enabled.
ENABLE_SCHEDULER=true
